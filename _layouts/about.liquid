---
layout: default
---
{% assign socials = site.data.socials %}
<div class="post home">
  <!-- Header: photo, greeting, bio, contact -->
  <section class="hero-band">
    <div class="hero-grid">
      {% if page.profile and page.profile.image %}
        <div class="hero-photo">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid rounded' %}
          {% endif %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes="280px" alt=page.profile.image
            cache_bust=true
          %}
        </div>
      {% endif %}

      <div class="hero-text">
        <h1 class="hero-title">
          {% if page.greeting %}{{ page.greeting }} {% endif -%}
          {%- if site.title == 'blank' -%}
            {{ site.first_name }}
            {% if site.middle_name %}{{ site.middle_name }} {% endif %}
            {{- site.last_name -}}
          {%- else -%}
            {{ site.title }}
          {%- endif %}
        </h1>
        {% if page.subtitle %}
          <p class="hero-subtitle">{{ page.subtitle }}</p>
        {% endif %}

        <div class="hero-bio">{{ content }}</div>

        {% if page.show_email and socials.email %}
          <a class="email-box" href="mailto:{{ socials.email | encode_email }}">
            <i class="fa-solid fa-envelope"></i>
            <span>{{ socials.email }}</span>
          </a>
        {% endif %}

        {% if page.social %}
          <div class="link-pills">
            {% if socials.scholar_userid %}
              <a class="pill" href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}">
                <i class="ai ai-google-scholar"></i> Scholar
              </a>
            {% endif %}
            {% if socials.orcid_id %}
              <a class="pill" href="https://orcid.org/{{ socials.orcid_id }}"> <i class="ai ai-orcid"></i> ORCID </a>
            {% endif %}
            {% if socials.github_username %}
              <a class="pill" href="https://github.com/{{ socials.github_username }}"> <i class="fa-brands fa-github"></i> GitHub </a>
            {% endif %}
            {% if socials.linkedin_username %}
              <a class="pill" href="https://www.linkedin.com/in/{{ socials.linkedin_username }}"> <i class="fa-brands fa-linkedin"></i> LinkedIn </a>
            {% endif %}
            {% if socials.cv_pdf %}
              <a class="pill" href="{{ socials.cv_pdf | relative_url }}"> <i class="fa-solid fa-file-lines"></i> CV </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- News -->
  {% if page.announcements and page.announcements.enabled %}
    <section class="home-block">
      <h2 class="block-title">Recent News</h2>
      {% include news_list.liquid limit=page.announcements.limit %}
      <p class="view-all"><a href="{{ '/news/' | relative_url }}">All news &rarr;</a></p>
    </section>
  {% endif %}

  <!-- Selected publications, grouped by topic -->
  {% if page.selected_topics %}
    <section class="home-block">
      <h2 class="block-title">Selected Publications</h2>
      {% for topic in page.selected_topics %}
        {% assign topic_id = topic.id %}
        <div class="topic-section">
          <div class="topic-label">
            <span>{{ topic.name }}</span>
          </div>
          <div class="topic-papers">
            {% bibliography --template bib_card --group_by none --query @*[topic={{topic_id}}] %}
          </div>
        </div>
      {% endfor %}
      <p class="view-all"><a href="{{ '/publications/' | relative_url }}">View all publications &rarr;</a></p>
    </section>
  {% endif %}
</div>
