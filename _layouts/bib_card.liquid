---
---
{% comment %}
  Publication card used on the home page (Selected Publications).
  Rendered by jekyll-scholar with the option "--template bib_card".
{% endcomment %}
<div class="pub-card" id="card-{{ entry.key }}">
  <div class="pub-media">
    {% if entry.preview %}
      {% if entry.preview contains '://' %}
        <img src="{{ entry.preview }}" alt="{{ entry.title | strip_html }}" loading="lazy">
      {% else %}
        {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
        {% include figure.liquid loading="lazy" path=entry_path sizes="320px" class="pub-img" alt=entry.title %}
      {% endif %}
    {% else %}
      <div class="pub-placeholder" aria-hidden="true">
        <i class="fa-solid fa-satellite"></i>
        {% if entry.abbr -%}
          <span>{{ entry.abbr }}</span>
        {%- endif %}
      </div>
    {% endif %}
  </div>

  <div class="pub-body">
    <h3 class="pub-title">{{ entry.title }}</h3>

    <div class="pub-venue">
      {% if entry.abbr -%}
        <span class="venue-pill">{{ entry.abbr }}</span>
      {%- endif %}
      {% if entry.note == 'Accepted' -%}
        <span class="venue-pill is-status">Accepted</span>
      {%- endif %}
    </div>

    <p class="pub-authors">
      {%- for author in entry.author_array -%}
        {%- assign author_last = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- if author_last == 'others' -%}
          et al.
        {%- else -%}
          {%- assign is_self = false -%}
          {%- if site.scholar.last_name contains author_last and site.scholar.first_name contains author.first -%}
            {%- assign is_self = true -%}
          {%- endif -%}
          {%- if is_self -%}
            <strong class="author-self">
              {{- author.first }}
              {{ author.last -}}
            </strong>
          {%- else -%}
            {{ author.first }}
            {{ author.last }}
          {%- endif -%}
        {%- endif -%}
        {%- unless forloop.last -%}, {% endunless -%}
      {%- endfor -%}
    </p>

    <div class="pub-links">
      {% if entry.website %}
        <a class="link-btn" href="{{ entry.website }}"><i class="fa-solid fa-globe"></i> Project Page</a>
      {% endif %}
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a class="link-btn" href="{{ entry.pdf }}"><i class="fa-solid fa-file-pdf"></i> PDF</a>
        {% else %}
          <a class="link-btn" href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}"><i class="fa-solid fa-file-pdf"></i> PDF</a>
        {% endif %}
      {% endif %}
      {% if entry.arxiv %}
        <a class="link-btn" href="https://arxiv.org/abs/{{ entry.arxiv }}"><i class="ai ai-arxiv"></i> arXiv</a>
      {% endif %}
      {% if entry.code %}
        <a class="link-btn" href="{{ entry.code }}"><i class="fa-solid fa-code"></i> Code</a>
      {% endif %}
      {% if entry.doi %}
        <a class="link-btn" href="https://doi.org/{{ entry.doi }}"><i class="ai ai-doi"></i> DOI</a>
      {% endif %}
    </div>
  </div>
</div>
